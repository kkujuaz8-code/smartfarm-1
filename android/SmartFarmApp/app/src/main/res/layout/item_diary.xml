<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="15dp">

        <TextView
            android:id="@+id/tvDiaryDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026-02-01"
            android:textColor="#888888"
            android:textSize="14sp"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/btnDelete"/>

        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            app:tint="#FF5252" />

        <TextView
            android:id="@+id/tvDiaryContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tvDiaryDate"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="일기 제목이 여기에 나옵니다."
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"/>

        <ImageView
            android:id="@+id/ivDiaryImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_below="@+id/tvDiaryContent"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            android:background="#EEEEEE"
            android:visibility="gone"/>

    </RelativeLayout>
</androidx.cardview.widget.CardView>